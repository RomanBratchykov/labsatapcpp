<Window
    x:Class="HomeworkGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HomeworkGUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="320"
    Height="470"
    mc:Ignorable="d">
    <Grid>
        <TextBlock
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="30"
            FontStyle="Italic"
            FontWeight="Light"
            Text="Shop &quot;Megabite&quot;"
            TextDecorations="Underline"
            TextWrapping="Wrap" />
        <TextBlock />
        <TextBlock
            Margin="22,80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Manufactorer"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="22,115,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Model"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="22,155,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Series"
            TextWrapping="Wrap" />
        <TextBlock
            Name="PriceText"
            Margin="22,192,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Price"
            TextWrapping="Wrap" />
        <ComboBox
            Name="Man"
            Width="120"
            Margin="123,80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SelectionChanged="Man_SelectionChanged"
            Text="Select manufatorer">
            <ComboBoxItem Content="Lenovo" />
            <ComboBoxItem Content="Asus" />
            <ComboBoxItem Content="Dell" />
        </ComboBox>
        <ComboBox
            x:Name="Model"
            Width="120"
            Margin="123,115,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SelectionChanged="Model_SelectionChanged"
            Text="Select model" />
        <ComboBox
            x:Name="Series"
            Width="120"
            Margin="123,155,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SelectionChanged="Series_SelectionChanged"
            Text="Select series" />
        <StackPanel />
        <StackPanel />
        <TextBox
            Name="Price"
            Width="120"
            Margin="123,192,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="False"
            Text=""
            TextWrapping="Wrap" />
        <GroupBox
            Width="86"
            Height="77"
            Margin="18,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Header="Discount">
            <StackPanel>
                <RadioButton
                    Name="dis10"
                    Height="24"
                    Click="dis10_Click"
                    Content="10%" />
                <RadioButton
                    Name="dis20"
                    Height="27"
                    Click="dis20_Click"
                    Content="20%" />
            </StackPanel>
        </GroupBox>
        <GroupBox
            Width="86"
            Height="77"
            Margin="183,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Header="Delivery">
            <StackPanel>
                <CheckBox
                    x:Name="dis1"
                    Height="24"
                    Checked="dis1_Checked"
                    Content="Nova"
                    Unchecked="dis1_Unchecked" />
                <CheckBox
                    x:Name="dis2"
                    Height="27"
                    Checked="dis2_Checked"
                    Content="Courier"
                    Unchecked="dis2_Unchecked" />
            </StackPanel>
        </GroupBox>
        <TextBlock
            Margin="22,326,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="To pay"
            TextWrapping="Wrap" />
        <TextBox
            Name="FinalPrice"
            Width="180"
            Height="20"
            Margin="89,326,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="False"
            Text=""
            TextWrapping="Wrap" />
        <Button
            Name="Buy"
            Width="87"
            Height="48"
            Margin="10,376,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Buy_Click"
            Content="Buy" />
        <Button
            Name="Clear"
            Width="88"
            Height="48"
            Margin="109,376,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Clear_Click"
            Content="Clear" />
        <Button
            Name="Leave"
            Width="87"
            Height="48"
            Margin="209,376,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Leave_Click"
            Content="Close" />
    </Grid>
</Window>
