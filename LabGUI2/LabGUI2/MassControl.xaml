<UserControl
    x:Class="LabGUI2.MassControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="250"
    Height="350">
    <Grid>
        <TextBlock
            Width="134"
            Margin="54,23,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Select unit from which" />
        <TextBlock
            Width="142"
            Margin="0,107,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Text="Select unit to what" />
        <ComboBox
            Name="StartUnit"
            Width="142"
            Height="34"
            Margin="0,55,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            SelectionChanged="StartUnit_SelectionChanged">
            <ComboBoxItem Content="Kilogram" />
            <ComboBoxItem Content="Pound" />
            <ComboBoxItem Content="Ounce" />
        </ComboBox>
        <ComboBox
            Name="Second"
            Width="142"
            Height="39"
            Margin="0,136,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
        <TextBox
            Name="GetValue"
            Width="120"
            Margin="61,201,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap" />
        <TextBlock
            Width="142"
            Margin="0,180,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Text="Enter value" />
        <TextBox
            Name="SetValue"
            Width="120"
            Margin="61,245,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap" />
        <TextBlock
            Width="142"
            Margin="50,224,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="False"
            Text="Result" />
        <Button
            Name="GetRes"
            Width="120"
            Height="27"
            Margin="61,282,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="GetRes_Click"
            Content="Get result" />
        <Button
            Name="BackButton"
            Width="39"
            Height="21"
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BackButton_Click"
            Content="Back" />

    </Grid>
</UserControl>
