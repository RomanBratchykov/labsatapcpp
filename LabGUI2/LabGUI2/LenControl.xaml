<UserControl
    x:Class="LabGUI2.LenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LabGUI2"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="350"
    d:DesignWidth="250"
    mc:Ignorable="d">
    <Grid>
        <TextBlock
            Width="134"
            Margin="54,23,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="Select unit from which" />
        <TextBlock
            Width="142"
            Margin="0,107,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Text="Select unit to what" />
        <ComboBox
            Name="StartUnit"
            Width="142"
            Height="34"
            Margin="0,55,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            SelectionChanged="StartUnitLen_SelectionChanged">
            <ComboBoxItem Content="Kilometer" />
            <ComboBoxItem Content="Yard" />
            <ComboBoxItem Content="Mile" />
        </ComboBox>
        <ComboBox
            Name="SecondLen"
            Width="142"
            Height="39"
            Margin="0,136,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
        <TextBox
            Name="GetValueLen"
            Width="120"
            Margin="61,201,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap" />
        <TextBlock
            Width="142"
            Margin="0,180,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Text="Enter value" />
        <TextBox
            Name="SetValueLen"
            Width="120"
            Margin="61,245,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="False"
            Text=""
            TextWrapping="Wrap" />
        <TextBlock
            Width="142"
            Margin="50,224,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="False"
            Text="Result" />
        <Button
            Name="GetRes"
            Width="120"
            Height="27"
            Margin="61,282,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="GetRes_Click_1"
            Content="Get result" />
        <Button
            Name="BackButton"
            Width="39"
            Height="21"
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BackButton_Click_1"
            Content="Back" />
    </Grid>
</UserControl>
