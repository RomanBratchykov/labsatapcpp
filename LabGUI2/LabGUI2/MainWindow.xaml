<Window x:Class="LabGUI2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabGUI2"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="250">
    <Grid>
        <Grid x:Name="MainMenu">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Select what to convert" Margin="0,0,0,10" FontSize="16"/>
                <Button Name="Mass" Content="Mass" Click="Mass_Click" Margin="0,5"/>
                <Button Name="Len" Content="Length" Click="Len_Click" Margin="0,5"/>
                <Button Name="Area" Content="Area" Click="Area_Click" Margin="0,5"/>
                <Button Name="Vol" Content="Volume" Click="Vol_Click" Margin="0,5"/>
                <Button Name="Exit" Content="Exit" Click="Exit_Click" Margin="0,5"/>
            </StackPanel>
            <TextBlock Name ="TimeDisplay" HorizontalAlignment="Left" Height="23" Margin="10,10,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="102"/>
        </Grid>

        <ContentControl x:Name="ContentArea" Visibility="Collapsed"/>
    </Grid>
</Window>
