<Window
    x:Class="LabGUI4.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LabGUI4"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Task Manager"
    Width="800"
    Height="450"
    mc:Ignorable="d"
    Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Дії">
                <MenuItem Click="AddTask_Click" Header="Додати завдання" />
                <MenuItem Click="MarkCompleted_Click" Header="Позначити як виконане" />
            </MenuItem>
            <MenuItem
                x:Name="Exit"
                Click="Exit_Click"
                Header="Вихід" />
        </Menu>

        <DataGrid ItemsSource="{Binding tasks}"
            x:Name="TasksGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="Назва" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Priority}"
                    Header="Пріоритет" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Status}"
                    Header="Статус" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding StartDate, StringFormat=dd.MM}"
                    Header="Дата початку" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Deadline, StringFormat=dd.MM}"
                    Header="Дедлайн" />
                <DataGridTextColumn
                    Width="Auto"
                     Binding="{Binding TimeRemainingDisplay}"
                    Header="Час до кінця" />
                <DataGridTemplateColumn Width="*" Header="Прогрес">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar
                                x:Name="ProgressMenu"
                                Width="100"
                                Height="20"
                                Maximum="100"
                                Value="{Binding Progress}">
                                <ProgressBar.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="ChangeDeadline_Click" Header="Змінити дедлайн" />
                                    </ContextMenu>
                                </ProgressBar.ContextMenu>
                            </ProgressBar>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Label
            x:Name="AnimatedLabel"
            Grid.Row="2"
            HorizontalAlignment="Left"
            Content="Менеджер завдань" />
    </Grid>
</Window>