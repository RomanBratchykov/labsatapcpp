<Window x:Class="DoorsCalculator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Налаштування інтерфейсу" Height="300" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <Label Content="Колір фону вікна:" />
            <xctk:ColorPicker x:Name="BackgroundColorPicker" SelectedColorChanged="BackgroundColorPicker_SelectedColorChanged" Width="100" />
            <Label Content="Колір фону вкладок:" />
            <xctk:ColorPicker x:Name="TabBackgroundColorPicker" SelectedColorChanged="TabBackgroundColorPicker_SelectedColorChanged" Width="100" />
            <Label Content="Розташування вкладок:" />
            <ComboBox x:Name="TabPlacementCombo" Width="100">
                <ComboBoxItem Content="Зверху" />
                <ComboBoxItem Content="Знизу" />
                <ComboBoxItem Content="Зліва" />
                <ComboBoxItem Content="Справа" />
            </ComboBox>
            <Button Content="Зберегти" Width="100" Margin="10" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>