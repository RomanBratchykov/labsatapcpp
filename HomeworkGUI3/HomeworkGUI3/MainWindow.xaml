<Window
    x:Class="HomeworkGUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HomeworkGUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="269"
    Height="330"
    mc:Ignorable="d" Closing="Window_Closing">
    <Grid>
        <Menu Grid.Row="0" >
            <MenuItem
                x:Name="SettingsButton"
                Click="SettingsButton_Click"
                Header="Settings"
                />
        </Menu>
        <TabControl
            x:Name="TabControl"
            Width="193"
            Height="150"
            Margin="0,33,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TabItem Header="Metal-Plasic">
                <StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            Text="Height (m):" />
                        <TextBox
                            x:Name="MetalHeightInput"
                            Width="80"
                            Margin="0,-15,10,0"
                            HorizontalAlignment="Right" />
                        <TextBlock
                            Width="66"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            Text="Width (m):" />
                        <TextBox
                            x:Name="MetalWidthInput"
                            Width="80"
                            Margin="0,-15,10,5"
                            HorizontalAlignment="Right" />
                    </StackPanel>
                    <TextBlock
                        Width="51"
                        Margin="23,10,0,0"
                        HorizontalAlignment="Left"
                        Text="Quantity:" />
                    <TextBox
                        x:Name="MetalQuantityInput"
                        Width="83"
                        Margin="0,-15,15,0"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Wooden">
                <StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            Text="Height (m):" />
                        <TextBox
                            x:Name="WoodenHeightInput"
                            Width="80"
                            Margin="0,-15,10,0"
                            HorizontalAlignment="Right" />
                        <TextBlock
                            Width="66"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            Text="Width (m):" />
                        <TextBox
                            x:Name="WoodenWidthInput"
                            Width="80"
                            Margin="0,-15,10,5"
                            HorizontalAlignment="Right" />
                    </StackPanel>
                    <TextBlock
                        Width="51"
                        Margin="23,10,0,0"
                        HorizontalAlignment="Left"
                        Text="Quantity:" />
                    <TextBox
                        x:Name="WoodenQuantityInput"
                        Width="83"
                        Margin="0,-15,15,0"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Button
            x:Name="ConfirmButton"
            Width="118"
            Height="28"
            Margin="0,196,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Click="ConfirmButton_Click"
            Content="Confirm purchase" />
        <Button
            x:Name="ExitButton"
            Width="69"
            Height="22"
            Margin="0,235,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="IndianRed"
            Click="ExitButton_Click"
            Content="Exit" />
    </Grid>
</Window>
