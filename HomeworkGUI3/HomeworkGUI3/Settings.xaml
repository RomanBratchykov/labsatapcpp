<Window
    x:Class="HomeworkGUI3.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HomeworkGUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    Width="250"
    Height="300"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <StackPanel Margin="10">

        <Button   x:Name="BackgroundClick"  Click="BackgroundClick_Click" Content="Choose Background Color" />

        <GroupBox Margin="5" Header="Tab Header Placement">
            <StackPanel>
                <RadioButton
                    Content="Top"
                    GroupName="TabPlacement"
                    Tag="Top" />
                <RadioButton
                    Content="Bottom"
                    GroupName="TabPlacement"
                    Tag="Bottom" />
                <RadioButton
                    Content="Left"
                    GroupName="TabPlacement"
                    Tag="Left" />
                <RadioButton
                    Content="Right"
                    GroupName="TabPlacement"
                    Tag="Right" />
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="5" Header="Tab Appearance">
            <StackPanel>
                <RadioButton
                    Content="Tabs"
                    GroupName="TabStyle"
                    Tag="Tab" />
                <RadioButton
                    Content="Buttons"
                    GroupName="TabStyle"
                    Tag="Button" />
                <RadioButton
                    Content="Flat Buttons"
                    GroupName="TabStyle"
                    Tag="FlatButton" />
            </StackPanel>
        </GroupBox>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button
                x:Name="ApplyBut"
                Margin="5"
                Click="ApplyBut_Click"
                Content="Apply" />
            <Button
                x:Name="Close"
                Margin="5"
                Click="Close_Click"
                Content="Exit" />
        </StackPanel>
    </StackPanel>
</Window>
